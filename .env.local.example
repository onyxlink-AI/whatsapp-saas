# ============================================================
# Supabase (required — NEXT_PUBLIC_* are exposed to browser)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role bypasses RLS — server-only, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# YCloud (WhatsApp provider)
# NOT env vars — configured PER WORKSPACE inside the app at
# Settings → Integraciones (API key + webhook signing secret, encrypted at rest).
# Each client/workspace has its own YCloud credentials and its own webhook URL.
# ============================================================

# ============================================================
# OpenRouter (LLM gateway) — server-only
# ============================================================
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# ============================================================
# Help Assistant (in-app "how do I use the panel" widget) — server-only.
# DELIBERATELY a separate OpenRouter account/key from OPENROUTER_API_KEY
# above, so its consumption can be tracked on its own, never mixed into the
# shared platform key's usage.
# ============================================================
HELP_ASSISTANT_OPENROUTER_API_KEY=your-separate-openrouter-api-key

# ============================================================
# HighLevel (CRM sync + calendar booking)
# No env vars needed — configured per workspace in Settings → Integraciones
# with a Private Integration Token (PIT) + Location ID + Calendar ID.
# ============================================================

# ============================================================
# Google Calendar (availability + booking) — server-only
# ONE service account for the whole platform (not per workspace). Each client
# grants access by sharing THEIR OWN Google Calendar with this service
# account's email (permission: "Make changes to events"). Per-workspace config
# (just the Calendar ID) lives in Settings → Integraciones → Google Calendar.
# See _onyxlink-handoff/12-GOOGLE_CALENDAR_SETUP.md for how to create it.
# ============================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the full PEM private key from the downloaded JSON key, keeping the
# \n line breaks literal (the app unescapes them at runtime).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ============================================================
# Encryption key for tenant credentials at rest (SEC-03)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# server-only, rotate every 90 days (bump ENCRYPTION_KEY_VERSION)
# ============================================================
ENCRYPTION_KEY=your-32-bytes-base64-encoded-key
ENCRYPTION_KEY_VERSION=v1

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================================
# Buffer process internal endpoint (SEC-05) — server-only
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')" | tr -d '\n'
# ============================================================
BUFFER_PROCESS_SECRET=your-buffer-process-secret-hex

# ============================================================
# Vercel Cron secret (set automatically by Vercel, add for local testing)
# ============================================================
CRON_SECRET=your-cron-secret

# ============================================================
# Recordatorios y seguimiento — interruptor global de envíos reales (fail-closed)
# Absent/anything other than the literal string "true" = NO se envía nada real,
# ni siquiera si todo lo demás (plantilla, consentimiento, número) está listo.
# Deja esta línea comentada/ausente mientras se trabaja en local.
# ============================================================
# REMINDERS_LIVE_SENDING_ENABLED=true

# Lista blanca de teléfonos autorizados a recibir un envío real de prueba
# (E.164, separados por coma). Vacía/ausente = ningún número autorizado, sin
# excepciones, incluso con el interruptor de arriba activado.
# REMINDERS_TEST_PHONE_ALLOWLIST=+5215500000000,+5215511111111

# ============================================================
# Asistente AI (voz, Vapi) — /api/webhooks/vapi
# Shared secret checked against the `x-vapi-secret` header Vapi sends when
# serverUrlSecret is configured on the assistant. One secret for the whole
# platform (not per workspace) — routing to the right workspace happens by
# matching the payload's assistantId against workspaces.vapi_assistant_id.
# ============================================================
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret-hex
# Optional, platform-level (not per-workspace). Without it, a linked
# assistant id can only ever show as "Configurado" — never fabricated as
# "Conexión verificada". Enables a real, read-only GET against Vapi's own
# API to confirm the assistant id is genuine; never used to place calls.
# VAPI_API_KEY=your-vapi-api-key
